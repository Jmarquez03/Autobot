<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>all_nodes</name>
  <version>0.0.0</version>
  <description>Your irresistible robot control package</description>
  <maintainer email="Jmarquezj545@gmail.com">ieee</maintainer>
  <license>Apache-2.0</license>

  <!-- Build dependencies that make things compile -->
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <!-- Core dependencies that'll make your nodes purr -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ackermann_msgs</depend>
  <depend>std_srvs</depend>

  <!-- Hardware whisperers -->
  <depend>python3-serial</depend>
  <depend>python3-smbus</depend>
  <depend>udev</depend>

  <!-- Node dependencies from your other packages -->
  <depend>robot_visualization</depend>
  <depend>sllidar_ros2</depend>
  <depend>bno055</depend>
  <depend>esp32_interface</depend>
  <depend>slam_toolbox</depend>
  <depend>twist_to_ackermann</depend>
  <depend>robot_localization</depend>

  <!-- Testing suite - keep those linters happy -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
